# La entrega usa el perfil local sin proveedores. No requiere crear un .env.
CENTINELA_DEMO_LOCAL=true

# --- Claude (Anthropic) — agente investigador ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = más rápido (recomendado para la demo). medium = análisis más profundo.
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_S=40
CLAUDE_MAX_TOOL_ROUNDS=4

# --- ElevenLabs — notas de voz (Scribe) y avisos hablados (TTS) ---
ELEVENLABS_API_KEY=
# ID de una voz española cálida de la Voice Library (o la voz clonada de un familiar, con su permiso)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# --- Investigación de enlaces ---
# Consulta RDAP para saber la antigüedad de los dominios (sin clave)
ONLINE_CHECKS=false
# Opcional: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_KEY=

# --- Aviso al familiar por Telegram (opcional) ---
# Crea un bot con @BotFather y obtén tu chat_id escribiendo al bot y visitando
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Escudo bancario ---
SHIELD_MINUTES=60
SHIELD_AMOUNT_THRESHOLD=300

# --- Escudo de llamada (Banco Demo, /llamada/) ---
# Usa la misma ANTHROPIC_API_KEY. Modelo rápido y barato para conversaciones cortas.
ESCUDO_MODEL=claude-haiku-5-5
ESCUDO_TIMEOUT_S=10

# --- Tope de gasto diario (al llegar: reglas, voz del navegador y casos al analista) ---
# El tope real de facturación ponlo también en la consola de Anthropic y en la de ElevenLabs.
IA_MAX_LLAMADAS_DIA=500
IA_MAX_TOKENS_DIA=4000000
VOZ_MAX_CARACTERES_DIA=30000
VOZ_MAX_TRANSCRIPCIONES_DIA=100

# --- Rutas de administración (reiniciar demo, simular mensajes, decidir casos, panel del familiar) ---
# El perfil de entrega siempre restringe el acceso al propio portátil.
ADMIN_REMOTO=false

# Forzar modo sin IA ni red (tests)
FORCE_OFFLINE=true
